        </UserObject>
        <UserObject label="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;/i&gt;&lt;br&gt;&lt;b&gt;IFuel&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 4px;line-height:1.6;&quot;&gt;+ hasPlayerEnough(EntityPlayer): Boolean&lt;br&gt;+ addTo(EntityPlayer): IFuel&lt;br&gt;+ takeFrom(EntityPlayer): IFuel&lt;br&gt;+ forceTakeFrom(EntityPlayer): Void&lt;br&gt;+ getLack(EntityPlayer): IFuel&lt;/p&gt;&lt;p style=&quot;margin:0 0 0 4px;line-height:1.6;&quot;&gt;+ empty(): Boolean&lt;/p&gt;" tooltip="Топливо - интерфейс, который обрабатывает игрока на входе и даёт ответ - достаточно ли у него топлива. Объект, реализующий этот интерфейс, и есть топливо, и ему подаётся игрок, и объект отвечает, достаточно ли у игрока топлива. Возможно, стоит сделать синглтон FuelManager, который будет получать игрока и объект IFuel, но принципиально это вообще ничего не изменит" id="NgL9zTfY4j_8i1bXmHwW-14">
          <mxCell style="verticalAlign=top;align=left;overflow=fill;fontSize=14;fontFamily=Helvetica;html=1;rounded=0;shadow=0;comic=0;labelBackgroundColor=none;strokeWidth=1;" parent="1" vertex="1">
