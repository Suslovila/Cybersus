        <UserObject label="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;FuelComposite&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 4px;line-height:1.6;&quot;&gt;+ forceTakeFrom(ItemStack): Void&lt;br&gt;+ tryTakeFuelFromPlayer(ItemStack): Boolean&lt;br&gt;+ takeFrom(ItemStack): FuelComposite&lt;br&gt;+ hasPlayerEnough(ItemStack): Boolean&lt;br&gt;+ getLack(ItemStack): FuelComposite&lt;br&gt;+ addTo(ItemStack): FuelComposite&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0 0 0 4px;line-height:1.6;&quot;&gt; empty: Boolean&lt;br&gt; fuels: List&amp;lt;IFuel&amp;gt;&lt;/p&gt;" tooltip="Топливный композит - содержит набор топлива, по сути является обёрткой вокруг List&lt;IFuel&gt;, предоставляющий удобное обращение к функциям интерфейса IFuel без &quot;fuels.foreach{...}&quot;" id="NgL9zTfY4j_8i1bXmHwW-13">
